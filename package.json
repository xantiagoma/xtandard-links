  "scripts": {
    "build": "bun run build:lib && bun run build:elysia2-types && bun run build:ui && bun run build:react",
    "build:lib": "vp pack",
    "build:elysia2-types": "tsc -p tsconfig.elysia2.build.json && xtandard-kit fix-elysia2-types",
    "test": "vp test run",
    "test:coverage": "vp test run --coverage",
    "test:bun": "bun test ./test/*.bun.test.ts",
    "lint": "vp lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.elysia2.json",
    "check": "vp lint && vp fmt --check && bun run typecheck",
    "prepare": "husky || true",
    "build:ui": "vite build --config vite.ui.config.ts",
    "dev:ui": "vite --config vite.ui.config.ts",
    "test:e2e": "playwright test",
    "standalone": "bun run apps/standalone/src/index.ts",
    "build:react": "vite build --config vite.react.config.ts && xtandard-kit scope-embed-css --scope xtandard-links && tsc -p tsconfig.react.json",
    "docs:dev": "cd site && bun install && bun run dev",
    "docs:build": "cd site && bun install && bun run build",
    "docs:preview": "cd site && bun run preview",
    "demo": "bun scripts/demo.ts",
    "seed:demo": "bun scripts/seed-demo.ts",
    "screenshots": "bun scripts/screenshots.ts",
    "typecheck:examples": "tsc -p examples/tsconfig.json",
    "examples:hono": "bun scripts/example.ts hono",
    "examples:elysia": "bun scripts/example.ts elysia",
    "examples:express": "bun scripts/example.ts express",
    "examples:bun": "bun scripts/example.ts bun",
    "examples:conversions": "bun scripts/example.ts conversions",
    "examples:deep-links": "bun scripts/example.ts deep-links",
    "examples:storage-drivers": "bun scripts/example.ts storage-drivers",
    "examples:react-embed": "bun scripts/example.ts react-embed",
    "release": "changelogen --release --push",
    "examples:webhooks-bridge": "bun scripts/example.ts webhooks-bridge"
  },
